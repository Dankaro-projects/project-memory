{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Dankaro-projects/project-memory",
  "title": "Project Memory",
  "description": "Local decisions, evidence, outcomes and reviewed lessons with bounded retrieval and an HTML viewer.",
  "repository": {
    "url": "https://github.com/Dankaro-projects/project-memory",
    "source": "github"
  },
  "version": "0.5.0b3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "project-memory-mcp",
      "version": "0.5.0b3",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--project",
          "value": "{project_path}",
          "variables": {
            "project_path": {
              "description": "Absolute path of a project initialised with project-memory setup.",
              "isRequired": true
            }
          }
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
